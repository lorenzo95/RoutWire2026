#       echo "{\"poolwg0\":\"$POOLWG\",\"poolvxlanv4\":\"$POOLV4\",\"poolvxlanv6\":\"$POOLV6\"}"
    echo "{\"pubkey\":\"recpubkey\",\"endpointip\":\"endpointip\",\"wg0ip\":\"$POOLWG\",\"wg0vxlanmac\":\"vxlanmac\",\"wg0vxlanip\":\"$POOLV4\",\"wg0vxlanip6\":\"$POOLV6\",\"hostname\":\"hostname\",\"ishub\":\"nill\"}" > $SERVERDIRECTORY/nodes.conf
fi

# MAIN LOOP
mosquitto_sub -h $MQTTIP -p $MQTTPORT -t $MQTTRESULTS |
while IFS= read -r encline
    log "[+] - New Loop"
    #log "Received MQTT message $encline"
    line=$(mqttdecrypt $encline)
    log "Received MQTT message $line"

    msgtype=$(json_extract msgtype $line)
    command=$(json_extract command $line)
    recpubkey=$(json_extract pubkey $line)
    endpointip=$(json_extract endpointip $line)
    hostname=$(json_extract hostname $line)
    endpointishub=$(json_extract ishub $line)
    mqttpeer=$MQTTCOMMANDS$( echo $recpubkey | base64 | cut -c1-16 )

        #log "$recpubkey $endpointip $hostname $mqttpeer"

    if [ ${#recpubkey} -ne 44 ]; then
        log "[-] - End Loop"
        continue
    fi

    # MORE LATER MAYBE
    if [ "$msgtype" = "anounce" ]; then
        if [ "$command" = "del_peer" ]; then
            log "Delete Peer"
            endpointip=$(json_extract endpointip $(cat $SERVERDIRECTORY/nodes.conf | grep "$recpubkey"))
            echo $(mqttencrypt "{\"msgtype\":\"anounce\",\"command\":\"del_peer\",\"pubkey\":\"$recpubkey\",\"endpointip\":\"$endpointip\"}") | mosquitto_pub --stdin-line -q 1 -h $MQTTIP -p $MQTTPORT -t $MQTTCOMMANDS
            log "Sending: {\"msgtype\":\"anounce\",\"command\":\"del_peer\",\"pubkey\":\"$recpubkey\"}"
            log "[-] - End Loop"
            continue
        fi
    fi

    do
        ISACTIONED=false
        while read FILELINE
        do
            LOCALPEER=$(json_extract pubkey $FILELINE)
            if [ $recpubkey = $LOCALPEER ] && [ "$ISACTIONED" = false ]; then
                log "PEER IS FOUND IN FILE: $LOCALPEER"

                endpointip=$(json_extract endpointip $FILELINE)
                wg0ip=$(json_extract wg0ip $FILELINE)
                wg0vxlanmac=$(json_extract wg0vxlanmac $FILELINE)
                wg0vxlanip=$(json_extract wg0vxlanip $FILELINE)
                wg0vxlanip6=$(json_extract wg0vxlanip6 $FILELINE)
                hostname=$(json_extract hostname $FILELINE)
                endpointishub=$(json_extract ishub $FILELINE)

                echo $(mqttencrypt "{\"msgtype\":\"direct\",\"command\":\"cmd_config_wg0\",\"pubkey\":\"$LOCALPEER\",\"wg0ip\":\"$wg0ip\"}") | mosquitto_pub --stdin-line -q 1 -h $MQTTIP -p $MQTTPORT -t $mqttpeer
                log "Sending wg0 config: $LOCALPEER cmd cmd_config_wg0 $wg0ip"
                echo $(mqttencrypt "{\"msgtype\":\"direct\",\"command\":\"cmd_config_vxlan\",\"wg0vxlanmac\":\"$wg0vxlanmac\",\"wg0vxlanip\":\"$wg0vxlanip\",\"wg0vxlanip6\":\"$wg0vxlanip6\"}") | mosquitto_pub --stdin-line -q 1 -h $MQTTIP -p $MQTTPORT -t $mqttpeer
                log "Sending vxlan config: $LOCALPEER cmd cmd_config_vxlan $wg0vxlanmac $wg0vxlanip $wg0vxlanip6 "

                echo $(mqttencrypt "{\"msgtype\":\"anounce\",\"command\":\"add_peer\",\"allowedips\":\"$(echo $wg0ip | cut -d/ -f1)\",\"pubkey\":\"$recpubkey\",\"endpointip\":\"$endpointip\",\"ishub\":\"$endpointishub\"}") | mosquitto_pub --stdin-line -q 1 -h $MQTTIP -p $MQTTPORT -t $MQTTCOMMANDS
                log "Sending anounce: {\"msgtype\":\"anounce\",\"command\":\"add_peer\",\"allowedips\":\"$(echo $wg0ip | cut -d/ -f1)\",\"pubkey\":\"$recpubkey\",\"endpointip\":\"$endpointip\",\"hostname\":\"$hostname\",\"ishub\":\"$endpointishub\"}"

                ISACTIONED=true
            fi
        done < $SERVERDIRECTORY/nodes.conf

        if [ "$ISACTIONED" = false ] ; then
            # Make new peer
            tag=$( tail -n 1 $SERVERDIRECTORY/nodes.conf )

            wg0ip=$(json_extract wg0ip $tag)
            wg0vxlanip=$(json_extract wg0vxlanip $tag)

            # Calculate new WG IP
            NEWWGIP="$(nextip $(echo $wg0ip | cut -d/ -f1))/$(echo $wg0ip | cut -d/ -f2)"
            log "Assigned new $hostname wg0 IP $NEWWGIP"

            # Calculate new VX IP
            NEWVXIP="$(nextip $(echo $wg0vxlanip | cut -d/ -f1))/$(echo $wg0vxlanip | cut -d/ -f2)"
            log "Assigned new $hostname VxLan IP $NEWVXIP"

            # Make new Mac address
            NEWMAC=$(printf '68:5d:43:%02X:%02X:%02X\n' $[RANDOM%256] $[RANDOM%256] $[RANDOM%256])
            log "Assigned new $hostname mac-address $NEWMAC"

            # Calculate new V6 IP
            NEWVV6IP="$(mac_to_ipv6_ll $NEWMAC)/$(echo $POOLV6 | cut -d/ -f2)"
            log "Assigned new $hostname IPv6 $NEWVV6IP"


            #Send config to peer
            RETURNWG="{\"msgtype\":\"direct\",\"command\":\"cmd_config_wg0\",\"pubkey\":\"$recpubkey\",\"wg0ip\":\"$NEWWGIP\"}"
            echo $(mqttencrypt "$RETURNWG") | mosquitto_pub --stdin-line -q 1 -h $MQTTIP -p $MQTTPORT -t $mqttpeer
            log "Sending wg0 config to peer: $RETURNWG"
            
            RETURNVX="{\"msgtype\":\"direct\",\"command\":\"cmd_config_vxlan\",\"wg0vxlanmac\":\"$NEWMAC\",\"wg0vxlanip\":\"$NEWVXIP\",\"wg0vxlanip6\":\"$(echo $NEWVV6IP | cut -d/ -f1)\",\"pubkey\":\"$recpubkey\",\"endpointip\":\"$endpointip\"}"
            echo $(mqttencrypt "$RETURNVX") | mosquitto_pub --stdin-line -q 1 -h $MQTTIP -p $MQTTPORT -t $mqttpeer
            log "Sending new VxLan config to Peer: $RETURNVX"

            echo $(mqttencrypt "{\"msgtype\":\"anounce\",\"command\":\"add_peer\",\"allowedips\":\"$(echo $NEWWGIP | cut -d/ -f1)\",\"pubkey\":\"$recpubkey\",\"endpointip\":\"$endpointip\",\"ishub\":\"$endpointishub\"}") | mosquitto_pub --stdin-line -q 1 -h $MQTTIP -p $MQTTPORT -t $MQTTCOMMANDS
            log "Sending anounce: {\"msgtype\":\"anounce\",\"command\":\"add_peer\",\"allowedips\":\"$(echo $NEWWGIP | cut -d/ -f1)\",\"pubkey\":\"$recpubkey\",\"endpointip\":\"$endpointip\",\"ishub\":\"$endpointishub\"}"

            echo "{\"pubkey\":\"$recpubkey\",\"endpointip\":\"$endpointip\",\"wg0ip\":\"$NEWWGIP\",\"wg0vxlanmac\":\"$NEWMAC\",\"wg0vxlanip\":\"$NEWVXIP\",\"wg0vxlanip6\":\"$NEWVV6IP\",\"hostname\":\"$hostname\",\"ishub\":\"$endpointishub\"}" >> $SERVERDIRECTORY/nodes.conf
            ISACTIONED=true

        fi

        # Update Peers and bridge tables

        while read FILELINE
        do
            LOCALPEER=$(json_extract pubkey $FILELINE)
            localendpointip=$(json_extract endpointip $FILELINE)
            wg0ip=$(json_extract wg0ip $FILELINE)
            wg0vxlanip=$(json_extract wg0vxlanip $FILELINE)
            wg0vxlanip6=$(json_extract wg0vxlanip6 $FILELINE)
            wg0vxlanmac=$(json_extract wg0vxlanmac $FILELINE)
            localendpointishub=$(json_extract ishub $FILELINE)
            hostname=$(json_extract hostname $FILELINE)

            if [ $localendpointip = "endpointip" ] || [ $localendpointip = "$endpointip" ]; then
                continue
            fi

            if [ "$localendpointishub" = "true" ] || [ "$endpointishub" = "true" ]; then
                echo $(mqttencrypt "{\"msgtype\":\"anounce\",\"command\":\"sync_peer\",\"allowedips\":\"$(echo $wg0ip | cut -d/ -f1)\",\"pubkey\":\"$LOCALPEER\",\"endpointip\":\"$localendpointip\"}") | mosquitto_pub -q 1 --stdin-line -h $MQTTIP -p $MQTTPORT -t $mqttpeer
                log "Sending anounce to $hostname: {\"msgtype\":\"anounce\",\"command\":\"sync_peer\",\"allowedips\":\"$(echo $wg0ip | cut -d/ -f1)\",\"pubkey\":\"$LOCALPEER\",\"endpointip\":\"$localendpointip\"}"
            else
                log "Not syncing peer: {\"pubkey\":\"$LOCALPEER\",\"endpointip\":\"$localendpointip\",\"hostname\":\"$hostname\"}"                  
            fi
        done < $SERVERDIRECTORY/nodes.conf


log "[-] - End Loop"
done
fi
