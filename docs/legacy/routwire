#Startup
if [ ! -d "$CLIENTDIRECTORY" ]; then
    # Control will enter here if $CLIENTDIRECTORY doesn't exist.
    log "Config Dir not found. Creating and making new keys."
    mkdir -p /etc/wireguard/keys
    chmod 700 /etc/wireguard/keys
    touch /etc/wireguard/keys/server
    chmod 600 /etc/wireguard/keys/server
    wg genkey > /etc/wireguard/keys/server
    wg pubkey < /etc/wireguard/keys/server > /etc/wireguard/keys/server.pub
elif [ -d "$CLIENTDIRECTORY" ]; then
    log "Config Dir found."
    #check if keys exist.
    if [ ! -f "$CLIENTDIRECTORY/server" ]; then
        log "No Key found. Generating new pair"
        touch /etc/wireguard/keys/server
        chmod 600 /etc/wireguard/keys/server
        wg genkey > /etc/wireguard/keys/server
        wg pubkey < /etc/wireguard/keys/server > /etc/wireguard/keys/server.pub
    fi
fi

#Grab correct local interface IP for peers to connect to
if [ "$ENDPOINTISPUBLIC" = false ]; then
    ENDPOINTIP=$(ip -o route get to 8.8.8.8 | sed -n 's/.*src \([0-9.]\+\).*/\1/p')
else
    ENDPOINTIP=$(curl http://checkip.amazonaws.com)
fi

#Grab interface name for iptables natting
if [ "$ISDEFAULTROUTE" = true ]; then
    ENDPOINTIF=$(ip -o route get to 8.8.8.8 |  awk '{print $5;}')
fi

#Get the local default gateway
LOCALDEFAULTROUTE=$(ip route | awk '/default/ { print $3 }')

#Anounce startup to server
PUBKEY=$(cat /etc/wireguard/keys/server.pub)
if [ "$ENDPOINTISNATTED" = false ]; then
    log "Announcing: $PUBKEY $ENDPOINTIP"
    echo $(mqttencrypt "{\"pubkey\":\"$PUBKEY\",\"hostname\":\"$(cat /etc/hostname)\",\"endpointip\":\"$ENDPOINTIP\",\"ishub\":\"$ENDPOINTISHUB\"}") | mosquitto_pub --stdin-line -q 1 -h $MQTTIP -p $MQTTPORT -t $MQTTRESULTS
    log "Sending {\"pubkey\":\"$PUBKEY\",\"hostname\":\"$(cat /etc/hostname)\",\"endpointip\":\"$ENDPOINTIP\",\"ishub\":\"$ENDPOINTISHUB\"}"
else
    log "Announcing: $PUBKEY"
    echo $(mqttencrypt "{\"pubkey\":\"$PUBKEY\",\"hostname\":\"$(cat /etc/hostname)\",\"endpointip\":\"behindnat\",\"ishub\":\"$ENDPOINTISHUB\"}") | mosquitto_pub --stdin-line -q 1 -h $MQTTIP -p $MQTTPORT -t $MQTTRESULTS
    log "Sending {\"pubkey\":\"$PUBKEY\",\"hostname\":\"$(cat /etc/hostname)\",\"endpointip\":\"behindnat\",\"ishub\":\"$ENDPOINTISHUB\"}"
fi

#Background Loop for Anounce CMD messages
while /bin/true; do
    mosquitto_sub -h $MQTTIP -p $MQTTPORT -t $MQTTCOMMANDS |
    while IFS= read -r encline; do
    #log "Received MQTT CMD Message: $encline"
    line=$(mqttdecrypt $encline)
    log "Received MQTT CMD Message: $line"

    msgtype=$(json_extract msgtype $line)
    command=$(json_extract command $line)
    recpubkey=$(json_extract pubkey $line)
    endpointip=$(json_extract endpointip $line)
    allowedips=$(json_extract allowedips $line)
    recendpointishub=$(json_extract ishub $line)
    #log "Received CMD Command: $msgtype $command $recpubkey $endpointip $allowedips"

    if [ $msgtype = "anounce" ]; then
        if [ $command = "add_peer" ] && [ ! $recpubkey = $PUBKEY ]; then
            if [ "$ENDPOINTISHUB" = "true" ] || [ "$recendpointishub" = "true" ]; then 
                bridge fdb append 00:00:00:00:00:00 dev wg0vxlan dst $allowedips via wg0
                if [ $endpointip = "behindnat" ]; then
                    wg set wg0 peer $recpubkey allowed-ips $allowedips/32
                    log "Adding new Peer $recpubkey WITHOUT endpoint"
                else
                    wg set wg0 peer $recpubkey allowed-ips $allowedips/32 endpoint $endpointip:51820
                    log "Adding new Peer $recpubkey at $endpointip:51820"
                      if [ $(ip route show | grep -co $endpointip ) = 0 ]; then
                        ip route add $endpointip via $LOCALDEFAULTROUTE
                      fi
                fi
            fi
        elif [ $command = "del_peer" ] && [ ! $recpubkey = $PUBKEY ]; then
                PEERIP=$(wg | grep -A 1 $recpubkey | tail -n 1 | awk '{print $2}' | cut -d: -f1)
                if [ ! $PEERIP = '' ] ; then
                  wg set wg0 peer $recpubkey remove
                  if [ ! $(ip route show | grep -co $PEERIP) = 0 ] ; then
                    ip route del $endpointip via $LOCALDEFAULTROUTE
                  fi
                fi
                log "Removing peer $recpubkey"
        fi
    fi
    done
done & #This loop runs in background
#Finnish Anounce loop


# MAIN LOOP
mqttpeer=$MQTTCOMMANDS$( echo $PUBKEY | base64 | cut -c1-16 )
log "$mqttpeer"

mosquitto_sub -c -i $mqttpeer -q 1 -h $MQTTIP  -p $MQTTPORT -t $mqttpeer |
while IFS= read -r encline
    #log "Received MQTT Message: $encline"
    line=$(mqttdecrypt $encline)
    log "Received MQTT Message: $line"

    msgtype=$(json_extract msgtype $line)
    command=$(json_extract command $line)
    recpubkey=$(json_extract pubkey $line)
    endpointip=$(json_extract endpointip $line)
    allowedips=$(json_extract allowedips $line)
    wg0ip=$(json_extract wg0ip $line)
    wg0vxlanip=$(json_extract wg0vxlanip $line)
    wg0vxlanip6=$(json_extract wg0vxlanip6 $line)
    wg0vxlanmac=$(json_extract wg0vxlanmac $line)
    #log "$msgtype $command $recpubkey $endpointip $allowedips $wg0ip $wg0vxlanip $wg0vxlanip6 $wg0vxlanmac"

    do
        RETURNVAL=false
        if [ "$msgtype" = "anounce" ]; then
            if [ $command = "sync_peer" ]; then
                bridge fdb append 00:00:00:00:00:00 dev wg0vxlan dst $allowedips via wg0
                if [ $endpointip = "behindnat" ]; then
                    wg set wg0 peer $recpubkey allowed-ips $allowedips/32
                    log "Adding new Peer $noThree WITHOUT endpoint"
                else
                    wg set wg0 peer $recpubkey allowed-ips $allowedips/32 endpoint $endpointip:51820
                    if [ $(ip route show | grep -co $endpointip ) = 0 ]; then
                      ip route add $endpointip via $LOCALDEFAULTROUTE
                    fi
                    log "Adding new Peer $recpubkey at $endpointip:51820"
                fi
            fi
        elif [ ! $recpubkey = $PUBKEY ]; then
            continue
        else
            if [ "$msgtype" = "direct" ]; then
                if [ $command = "cmd_getip_private" ]; then
                    RETURNVAL=$(ip -o route get to 8.8.8.8 | sed -n 's/.*src \([0-9.]\+\).*/\1/p')
                elif [ $command = "cmd_getip_public" ]; then
                    RETURNVAL=$(curl http://checkip.amazonaws.com)
                elif [ $command = "cmd_config_wg0" ]; then
                    if ip link show wg0 > /dev/null 2>&1; then
                        log "Already have wg0. Deleting..."
                        ip link delete dev wg0
                    fi
                    ip link add wg0 type wireguard
                    ip link set dev wg0 mtu 2016
                    wg set wg0 listen-port 51820 private-key /etc/wireguard/keys/server
                    ip addr add $wg0ip dev wg0
                    ip link set wg0 up

                    #RETURNVAL=$(ip add show dev wg0)
                    log "New wg0 created"
                elif [ $command = "cmd_config_vxlan" ]; then
                    if ip link show wg0vxlan > /dev/null 2>&1; then
                        log "Deleting vxlan interface"
                        ip link delete dev wg0vxlan
                    fi
                    ip link add wg0vxlan address $wg0vxlanmac mtu 1966 type vxlan id 8425532 dstport 4789 ttl 1 noudpcsum || true
                    ethtool -K wg0vxlan tx off rx off > /dev/null 2>&1
                    sysctl -w net.ipv4.conf.wg0vxlan.accept_redirects=0 net.ipv4.conf.wg0vxlan.send_redirects=0 net.ipv6.conf.wg0vxlan.accept_redirects=0 > /dev/null 2>&1
                    ip address add $wg0vxlanip dev wg0vxlan || true
                    ip address add $wg0vxlanip6 dev wg0vxlan || true
                    ip link set wg0vxlan up
                    log "New Vxlan Interface created."


                    #Fire up Babeld
                    while true; do
                      if ping $(echo $wg0vxlanip | cut -d/ -f1) -c 3 > /dev/null 2>&1  ; then
                        if [ "$ISDEFAULTROUTE" = true ] ; then
                          echo "redistribute ip 0.0.0.0/0 eq 0  metric $ROUTEMETRIC" >> babel.conf
                          echo "redistribute ip ::/0 eq 0 src-prefix $wg0vxlanip6 metric $ROUTEMETRIC" >> babel.conf
                          echo "redistribute local deny" >> babel.conf
                          echo "redistribute deny" >> babel.conf
                          babeld -c babel.conf &

                          sysctl -w net.ipv4.ip_forward=1 net.ipv6.conf.all.forwarding=1 > /dev/null 2>&1
                          if ! iptables -C POSTROUTING -t nat -o $ENDPOINTIF -j MASQUERADE > /dev/null 2>&1 ; then
                            iptables -t nat -A POSTROUTING -o $ENDPOINTIF -j MASQUERADE
                          fi
                          if ! iptables -C FORWARD -i wg0vxlan -j ACCEPT > /dev/null 2>&1 ; then
                            iptables -A FORWARD -i wg0vxlan -j ACCEPT
                          fi
                          if ! iptables -C FORWARD -o wg0vxlan -j ACCEPT > /dev/null 2>&1 ; then
                            iptables -A FORWARD -o wg0vxlan -j ACCEPT
                          fi
                          break
                        else
                          echo "redistribute local deny" >> babel.conf
                          echo "redistribute deny" >> babel.conf
                          babeld -c babel.conf &
                          break
                        fi
                      fi
                    done

                    #RETURNVAL=$(ip add show dev wg0vxlan)
                elif [ $command = "cmd_machine-id" ]; then
                    RETURNVAL="{\"msgtype\":\"direct\",\"machineid\":\"$(cat /etc/machine-id)\"}"
                else
                    Log "Made it to else statement"
                fi
            elif [ "$command" = "stats" ]; then
                log "Returning some stats?"
            fi
        fi

if [ ! "$RETURNVAL" = false ]
then
    echo $(mqttencrypt "$RETURNVAL") | mosquitto_pub --stdin-line -h $MQTTIP -p $MQTTPORT -t $MQTTRESULTS
fi

done
