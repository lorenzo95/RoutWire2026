ENDPOINTIF=$(ip -o route get to 8.8.8.8 |  awk '{print $5;}')
#myinterfaces=$(ip link show | grep '^[0-9]' | awk '{print $2}' | cut -d: -f1 | grep -v -e "lo" -e "wg0" -e "$ENDPOINTIF")

