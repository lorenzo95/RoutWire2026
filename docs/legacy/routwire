# Routing information
ISDEFAULTROUTE=false
ROUTEMETRIC=111

###
### Variables (Server)
###

SERVERDIRECTORY=$(pwd)
POOLWG="169.254.124.0/16"
POOLV4="172.20.10.0/24"
# get one here https://simpledns.com/private-ipv6
POOLV6="fd20:b765:de64:0d5c::/64"

